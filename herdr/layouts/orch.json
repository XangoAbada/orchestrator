{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "preview": "layouts/orch.svg",
  "children": [
    {
      "id": "orch-bar",
      "type": "block",
      "size": { "px": 42 },
      "window_drag": true,
      "content": { "mod": "tabs-orch" }
    },
    {
      "id": "orch-body",
      "type": "row",
      "padding": 8,
      "gap": 8,
      "children": [
        {
          "id": "orchestrator",
          "type": "block",
          "size": { "weight": 1 },
          "min": 320,
          "radius": 10,
          "background": "background",
          "border": { "width": 1, "color": "border" },
          "focus": { "border": { "width": 1, "color": "accent" } },
          "content": { "terminal": "orchestrator" }
        },
        {
          "id": "tasks",
          "type": "block",
          "size": { "weight": 1 },
          "min": 280,
          "radius": 10,
          "border": { "width": 1, "color": "border" },
          "content": { "mod": "tasks" }
        }
      ]
    }
  ]
}
